# Ambiente de execução do servidor Express (usar "production" na Hostinger)
NODE_ENV="production"

# Porta HTTP onde o servidor Express escuta (na Hostinger é normalmente injetada automaticamente)
PORT="3000"

# Limite máximo de tarefas simultâneas dentro do processo Node.js (recomendado Hostinger: 4)
MAX_CONCURRENT_TASKS="4"

# URL pública da aplicação em produção (opcional / informativo)
APP_URL="https://seu-dominio.pt"

# --- Firebase / Cloud Firestore (usado exclusivamente no backend em server/firebaseSync.ts) ---
# Chave de API Web do projeto Firebase
FIREBASE_API_KEY="SUA_FIREBASE_API_KEY"

# Domínio de autenticação Firebase (ex: seu-projeto.firebaseapp.com)
FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"

# ID do projeto Firebase
FIREBASE_PROJECT_ID="seu-projeto-id"

# Bucket de armazenamento Firebase (ex: seu-projeto.firebasestorage.app)
FIREBASE_STORAGE_BUCKET="seu-projeto.firebasestorage.app"

# ID do remetente de mensagens Firebase
FIREBASE_MESSAGING_SENDER_ID="SEU_MESSAGING_SENDER_ID"

# ID da aplicação Web Firebase
FIREBASE_APP_ID="1:000000000000:web:0000000000000000"

# ID da base de dados Firestore (usar "(default)" ou o ID da base de dados aprovisionada)
FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# --- Opcional / Reservado (não utilizado atualmente em runtime, presente nas dependências base) ---
# GEMINI_API_KEY="SUA_GEMINI_API_KEY"
